# انسخ هذا الملف إلى .env واملأ القيم بنفسك. لا تشارك هذا الملف مع أحد.

# مفاتيح OKX - أنشئها من OKX > API Management بصلاحية "Trade" فقط (بدون Withdraw)
# ويفضّل تقييدها بـ IP الجهاز الذي سيشغّل البوت.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# استخدم true لحساب OKX Demo Trading (نفس المفاتيح تُنشأ من وضع Demo في OKX)
OKX_DEMO=false

# كلمة سر الدخول للوحة التحكم (لأنها متاحة على شبكتك المحلية من الجوال)
APP_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-random-long-string

# paper = محاكاة بدون إرسال أوامر حقيقية | live = تنفيذ فعلي على حسابك
TRADING_MODE=paper

DATABASE_URL=sqlite+aiosqlite:///./trading.db
